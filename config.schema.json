                        },
                        {
                          "key": "accessories[].rightbutton",
                          "flex": "1 1 100px"
                        }
                      ]
                    },
                    {
                      "type": "flex",
                      "displayFlex": true,
                      "flex-direction": "row",
                      "items": [
                        {
                          "flex": "1 1 100px"
                        },
                        {
                          "key": "accessories[].downbutton",
                          "flex": "1 1 100px"
                        },
                        {
                          "flex": "1 1 100px"
                        }
                      ]
                    },
                    {
                      "type": "flex",
                      "displayFlex": true,
                      "flex-direction": "row",
                      "items": [
                        {
                          "key": "accessories[].playpausebutton",
