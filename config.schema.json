{
  "pluginAlias": "HomebridgeADB",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "A simple homebridge plugin to control ADB enabled Android devices",
  "footerDisplay": "For more information, see the [README](https://github.com/dwaan/homebridge-adb/blob/master/README.md) or [FAQ](https://github.com/dwaan/homebridge-adb/blob/master/FAQ.md).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Plugin Name",
        "type": "string",
        "default": "Homebridge ADB",
        "required": true
      },
      "accessories": {
        "title": "Android Devices",
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "title": "Device Name",
              "placeholder": "Eg: Your Device Name",
              "minLength": 1,
              "required": true
            },
            "ip": {
              "type": "string",
              "title": "IP Address",
              "placeholder": "Eg: 192.168.1.1",
              "format": "ipv4",
              "required": true
            },
            "adbport": {
              "type": "number",
              "title": "ADB Port",
              "minimum": 1,
              "maximum": 65535,
              "default": 5555
            },
            "mac": {
              "type": "string",
              "title": "MAC address",
              "placeholder": "Eg: 4d:23:ca:5e:78:3e",
              "format": "mac",
              "required": false
            },
            "timeout": {
              "type": "number",
              "title": "ADB Timeout",
              "minimum": 1000,
              "maximum": 10000,
              "default": 3000
            },
            "interval": {
              "type": "number",
              "title": "Polling interval",
              "minimum": 500,
              "maximum": 10000,
              "default": 5000
            },
            "category": {
              "type": "string",
              "title": "Category",
              "oneOf": [
                { "title": "Apple TV", "enum": ["APPLE_TV"] },
                { "title": "Television", "enum": ["TELEVISION"] },
                { "title": "Streaming Stick", "enum": ["TV_STREAMING_STICK"] },
                { "title": "Set Top Box", "enum": ["TV_SET_TOP_BOX"] },
                { "title": "Audio Receiver", "enum": ["AUDIO_RECEIVER"] },
                { "title": "Speaker", "enum": ["SPEAKER"] }
              ]
            },
            "inputs": {
              "title": "Inputs",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "title": "Name",
                    "type": "string",
                    "placeholder": "eg: App name",
                    "required": true
                  },
                  "id": {
                    "title": "App ID",
                    "type": "string",
                    "placeholder": "eg: com.your.app.id",
                    "required": true
                  },
                  "adb": {
                    "title": "Command",
                    "type": "string",
                    "placeholder": "eg: am start -a android.intent.action.VIEW ...",
                    "required": false
                  },
                  "switch": {
                    "title": "Also create Switch accessory for this input",
                    "type": "boolean",
                    "required": false
                  }
                }
              }
            },
            "hidenumber": {
              "type": "boolean",
              "title": "Hide 'Inputs' number in Home App"
            },
            "hiddeninputslots": {
              "type": "number",
              "title": "Reserved Hidden Input Slots",
              "minimum": 0,
              "maximum": 50,
              "default": 0
            },
            "hidehome": {
              "type": "boolean",
              "title": "Hide 'Home' Input in Home App"
            },
            "hideother": {
              "type": "boolean",
              "title": "Hide 'Other' Input in Home App"
            },
            "playbacksensor": {
              "type": "boolean",
              "title": "Playback as Motion Sensor"
            },
            "debug": {
              "type": "boolean",
              "title": "Display more debug messages"
            },
            "skipSpeaker": {
              "type": "boolean",
              "title": "Skip speaker/volume creation"
            },
            "poweron": {
              "type": "string",
              "title": "Power On",
              "placeholder": "Eg: WAKE or KEYCODE_POWER"
            },
            "poweroff": {
              "type": "string",
              "title": "Power Off",
              "placeholder": "Eg: KEYCODE_SLEEP"
            },
            "connectonstartup": {
              "type": "boolean",
              "title": "Connect On Startup",
              "description": "Attempt a startup ADB connect before publishing the accessory.",
              "default": false
            },
            "keepadbalivewhensleeping": {
              "type": "boolean",
              "title": "Keep ADB Alive While Sleeping",
              "description": "Attempt periodic ADB keepalive while the device is sleeping without waking the display.",
              "default": false
            },
            "keepaliveinterval": {
              "type": "number",
              "title": "Keepalive Interval",
              "minimum": 10000,
              "maximum": 300000,
              "default": 10000
            },
            "connectiondebouncecount": {
              "type": "number",
              "title": "Connection Debounce Count",
              "minimum": 1,
              "maximum": 10,
              "default": 2
            },
            "suppresssleepingdisconnectlogs": {
              "type": "boolean",
              "title": "Suppress Sleeping Disconnect Logs",
              "default": true
            },
            "markasleepwhendisconnected": {
              "type": "boolean",
              "title": "Mark Asleep When ADB Disconnects",
              "description": "If the device drops ADB when it turns off, mark the TV asleep in HomeKit.",
              "default": false
            },
            "startupsettledelay": {
              "type": "number",
              "title": "Startup Settle Delay",
              "minimum": 0,
              "maximum": 10000,
              "default": 250
            },
            "powersettledelay": {
              "type": "number",
              "title": "Power Settle Delay",
              "minimum": 0,
              "maximum": 60000,
              "default": 12000
            },
            "fastpoweroff": {
              "type": "boolean",
              "title": "Fast Power Off",
              "description": "Send KEYCODE_SLEEP once without waiting for a wrapper power-off loop.",
              "default": false
            },
            "stateAdbCommand": {
              "type": "string",
              "title": "State Command",
              "placeholder": "eg: dumpsys power"
            },
            "stateAdbOutputAwake": {
              "type": "string",
              "title": "State Command Output",
              "placeholder": "eg: Awake"
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "accessories",
      "type": "array",
      "items": [
        {
          "type": "flex",
          "items": [
            {
              "type": "flex",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                { "key": "accessories[].name" }
              ]
            },
            {
              "type": "flex",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                { "key": "accessories[].ip", "flex": "2 2 200px" },
                { "key": "accessories[].adbport", "flex": "1 1 100px" },
                { "key": "accessories[].category", "flex": "1 1 100px" }
              ]
            },
            {
              "type": "flex",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                { "key": "accessories[].timeout", "flex": "1 1 100px" },
                { "key": "accessories[].interval", "flex": "1 1 100px" }
              ]
            },
            {
              "type": "flex",
              "displayFlex": true,
              "flex-direction": "row",
              "items": [
                { "key": "accessories[].timeout", "flex": "1 1 100px" },
                { "key": "accessories[].interval", "flex": "1 1 100px" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
