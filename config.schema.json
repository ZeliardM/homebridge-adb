                        },
                        {
                          "key": "accessories[].backbutton",
                          "flex": "1 1 100px"
                        },
                        {
                          "key": "accessories[].infobutton",
                          "flex": "1 1 100px"
                        }
                      ]
                    }
                  ]
                },
                {
                  "title": "Power",
                  "description": "Custom <a href='https://developer.android.com/reference/android/view/KeyEvent' target='blank'>ADB keycodes</a>, app id, or shell script for power.",
                  "items": [
                    {
                      "type": "flex",
                      "displayFlex": true,
                      "flex-direction": "row",
                      "items": [
                        {
                          "key": "accessories[].poweron",
