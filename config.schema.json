                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "Settings",
              "expandable": true,
              "expanded": false,
              "description": "Other additional settings.",
              "items": [
                {
                  "type": "flex",
                  "displayFlex": true,
                  "flex-direction": "row",
                  "items": [
                    {
                      "key": "accessories[].debug",
